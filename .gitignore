# Personal config — copy config.sh.example to config.sh and fill it in
config.sh

# Personal Clio files — copy *.example.md versions as starting points
memory.md
soul.md
journal.md

# OAuth credentials and token script — machine-specific secrets
server/credentials.json
server/get_token.py

# First-run tracking — created on first server start
.first_run_complete

# TLS certificates — generated per machine by start.sh
clio.crt
clio.key
clio-local.crt
clio-local.key

# Local display-link auth token — regenerated every server start
server/.session_token

# Log files
server.log
server.log.1
display.log

# Runtime directories
.venv/
.tools/
server/__pycache__/
server/tmp/
server/logs/

# Manual test workspace — generated by tests/manual/reset.sh
tests/manual/workspace/

# Model files — downloaded separately (see README)
server/models/*
!server/models/.gitkeep

# Claude Code local settings
.claude/settings.local.json

# Python
*.pyc
*.pyo
*.pyd

# display/ (Electron + Vite)
display/node_modules/
display/out/
display/dist/
display/.vite/
