# What would you like Clio to call you? This can be your name, a nickname, or anything you prefer.
USER_NAME=""

# Networking mode: "tailscale" (default, recommended) or "cloudflare"
#
# tailscale — uses Tailscale for peer-to-peer access. Requires Tailscale installed
#             on both your laptop and phone. Traffic stays on your local network.
#
# cloudflare — uses Cloudflare Tunnel (cloudflared). No Tailscale needed, easier
#              setup, but audio routes through Cloudflare's servers.
#
TUNNEL_MODE="tailscale"

# Whisper model for speech recognition.
# Options: tiny, base, small (default), medium, large
# tiny is fastest but least accurate; large is most accurate but slowest on CPU.
WHISPER_MODEL="small"

# Language for speech recognition. Set to a language code (e.g. "en") to prevent
# Whisper from misidentifying your speech as another language. Leave empty to auto-detect.
STT_LANGUAGE="en"

# Your Tailscale hostname — run `tailscale status` to find it.
# Only required when TUNNEL_MODE=tailscale.
TAILSCALE_HOST="your-machine.tail12345.ts.net"

# Your Anthropic API key — get one at https://console.anthropic.com → API Keys
# The installer sets this automatically. You can also set it here manually.
export ANTHROPIC_API_KEY=""

# Your ntfy.sh topic for push notifications to your phone (optional).
# Create a topic at ntfy.sh and paste it here. Leave empty to disable.
NTFY_TOPIC=""

# TTS engine: "kokoro" (default, higher quality) or "piper" (fallback)
TTS_ENGINE="kokoro"

# Kokoro voice to use. Only applies when TTS_ENGINE=kokoro.
# American English (female): af_bella (recommended), af_heart, af_nicole, af_sarah, af_sky
# American English (male):   am_michael, am_fenrir, am_puck, am_adam
# British English (female):  bf_emma, bf_isabella, bf_alice, bf_lily
# British English (male):    bm_george, bm_fable, bm_daniel, bm_lewis
# See full list: https://huggingface.co/hexgrad/Kokoro-82M/blob/main/VOICES.md
KOKORO_VOICE="af_bella"
